#!/usr/bin/env expect

set model_arg "Qwen2-7B-Instruct"
set model_dir_arg "/home/share/models/Qwen2-7B-Instruct"
set dp_size_arg 1
set pp_size_arg 1
set tp_size_arg 1
set ep_size_arg 1

# Process command line arguments
if {[llength $argv] > 0} {
    for {set i 0} {$i < [llength $argv]} {incr i} {
        set arg [lindex $argv $i]
        if {$arg eq "--model"} {
            incr i
            set model_arg [lindex $argv $i]
        } elseif {$arg eq "--model-dir"} {
            incr i
            set model_dir_arg [lindex $argv $i]
        } elseif {$arg eq "--dp-size"} {
            incr i
            set dp_size_arg [lindex $argv $i]
        } elseif {$arg eq "--pp-size"} {
            incr i
            set pp_size_arg [lindex $argv $i]
        } elseif {$arg eq "--tp-size"} {
            incr i
            set tp_size_arg [lindex $argv $i]
        } elseif {$arg eq "--ep-size"} {
            incr i
            set ep_size_arg [lindex $argv $i]
        }
    }
}

set world_size [expr {$dp_size_arg * $pp_size_arg * $tp_size_arg}]
set MASTER_PORT [expr {int(rand() * 1000) + 51000}]
set SERVE_PORT [expr {int(rand() * 1000) + 21003}]

# Launch the server
spawn timeout 10m torchrun --nproc_per_node $world_size --master_port $MASTER_PORT -m chitu \
    models=$model_arg \
    models.ckpt_dir=$model_dir_arg \
    infer.dp_size=$dp_size_arg \
    infer.pp_size=$pp_size_arg \
    infer.tp_size=$tp_size_arg \
    infer.ep_size=$ep_size_arg \
    infer.cache_type=paged \
    infer.max_reqs=2 \
    infer.max_seq_len=1024 \
    serve.host=127.0.0.1 \
    serve.port=$SERVE_PORT
set pid [exp_pid]
puts "Launching sever, pid is $pid"

# Wait for the server to start
expect -timeout -1 "Uvicorn running on"

# Test the server
puts "Starting test..."
system python3 test/test_stream_response.py http://127.0.0.1:$SERVE_PORT/v1/chat/completions 2 256

# Clean up
puts "Testing done. You may see some killing messages following, which is expected."
puts "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
system kill $pid
