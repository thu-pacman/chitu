#!/usr/bin/expect

# Parse command line parameters
set model_arg "Qwen3-32B"
set model_dir_arg "/data/nfs/Qwen3-32B"
set tp_size_arg 2
set cache_type_arg "paged"
set max_reqs_arg 64
set batch_sizes_arg ""
set send_notification 1
if {[info exists env(FEISHU_BOT_URL)]} {
    set webhook_url_arg $env(FEISHU_BOT_URL)
} else {
    set webhook_url_arg ""
}

# Process command line arguments
if {[llength $argv] > 0} {
    for {set i 0} {$i < [llength $argv]} {incr i} {
        set arg [lindex $argv $i]
        if {$arg eq "--model"} {
            incr i
            set model_arg [lindex $argv $i]
        } elseif {$arg eq "--model-dir"} {
            incr i
            set model_dir_arg [lindex $argv $i]
        } elseif {$arg eq "--tp-size"} {
            incr i
            set tp_size_arg [lindex $argv $i]
        } elseif {$arg eq "--cache-type"} {
            incr i
            set cache_type_arg [lindex $argv $i]
        } elseif {$arg eq "--benchmark-max-batch-size"} {
            incr i
            set max_reqs_arg [lindex $argv $i]
        } elseif {$arg eq "--benchmark-batch-sizes"} {
            incr i
            set batch_sizes_arg [lindex $argv $i]
        } elseif {$arg eq "--no-notify"} {
            # Flag to disable notification sending
            set send_notification 0
        } elseif {$arg eq "--webhook-url"} {
            incr i
            set webhook_url_arg [lindex $argv $i]
        }
    }
}

# Detect hardware environment - Check if NPUs are available
set check_output [exec bash -c "source script/check_npus.sh 2>/dev/null"]
# Install required dependencies
exec pip install aiohttp -i https://pypi.tuna.tsinghua.edu.cn/simple 2>/dev/null

# Initialize hardware detection variables
set USE_NPU 0
set NPU_TYPE ""

# Parse the output from hardware detection script
foreach line [split $check_output "\n"] {
    if {[string match "USE_NPU=*" $line]} {
        set USE_NPU [string range $line 8 end]
    }
    if {[string match "NPU_TYPE=*" $line]} {
        set NPU_TYPE [string range $line 9 end]
    }
}

# Display detected hardware information
puts "USE_NPU = $USE_NPU"
if {$USE_NPU == 1} {
    puts "NPU_TYPE = $NPU_TYPE"
}

# Select appropriate attention implementation based on hardware
set ATNN_TYPE_ARG "auto"
if {$USE_NPU == 1} {
    set ATNN_TYPE_ARG "npu"
}

# Configure model-specific parameters
set extra_args ""
set MAX_REQS $max_reqs_arg

# Special handling for DeepSeek-R1 models
if {[string first "DeepSeek-R1" $model_arg] != -1} {
    append extra_args " infer.mla_absorb=absorb-without-precomp"
    
    # Check if it's FP4 version and running on NPU
    if {[string first "FP4" $model_arg] != -1 && $USE_NPU == 1} {
        append extra_args " infer.npu_fusion_fp4=True"
        append extra_args " infer.raise_lower_bit_float_to=bfloat16"
        append extra_args " keep_dtype_in_checkpoint=True"
    }
}

puts "Model extra args: $extra_args"
set MASTER_PORT [expr {int(rand() * 1000) + 51000}]
set SERVE_PORT [expr {int(rand() * 1000) + 21003}]
set extra_args {*}$extra_args

# Launch the server
spawn sh -c "torchrun --nproc_per_node $tp_size_arg --master_port $MASTER_PORT -m chitu \
    models=$model_arg \
    models.ckpt_dir=$model_dir_arg \
    infer.cache_type=$cache_type_arg \
    infer.attn_type=$ATNN_TYPE_ARG \
    infer.max_reqs=$MAX_REQS \
    infer.max_seq_len=1200 \
    infer.tp_size=$tp_size_arg \
    infer.use_cuda_graph=True \
    serve.port=$SERVE_PORT \
    $extra_args | tee /data/nfs/daily_benchmark_debug/logfile.txt"

set pid [exp_pid]
puts "Launching server, pid is $pid"

# Time limit
after 1800000 {
    puts "Reaching the time limit: $pid, killing..."
    if {[catch {exec kill -9 $pid} err]} {
        puts "Error: $err"
    } else {
        puts "Service(PID: $pid) killed"
    }
}

# Wait for the server to start
expect -timeout -1 "Uvicorn running on"

# Prepare model configuration summary for reporting
set model_info "Model: $model_arg\n"
append model_info "TP Size: $tp_size_arg\n"
append model_info "Attention Type: $ATNN_TYPE_ARG\n"
append model_info "Cache Type: $cache_type_arg\n"
append model_info "Use_cuda_graph: True\n"
append model_info "\n"

# Initialize formatted records with header
set column_format "%-12s %-24s %-14s %-11s %-11s %s"
set benchmark_formated_records [format $column_format "Batch Size" "Benchmark duration (s)" "TPS (tok/s)" "TTFT (ms)" "TPOT (ms)" "Total Throughput (tok/s)"]
append benchmark_formated_records "\n"

append benchmark_formated_records [format $column_format "------------" "------------------------" "--------------" "-----------" "-----------" "-------------------------"]
append benchmark_formated_records "\n\n"

# Loop over batch sizes
if {$batch_sizes_arg eq ""} {
    set bs 1
    set batch_sizes [list]
    while {$bs <= $MAX_REQS} {
        lappend batch_sizes $bs
        set bs [expr {$bs * 2}]
    }
} else {
    set batch_sizes [split $batch_sizes_arg " "]
}
foreach bs $batch_sizes {
    puts "Starting test with batch size = $bs..."

    # Run benchmark and capture output (including stderr)
    if {[catch {
        set output [exec python benchmarks/benchmark_serving.py \
            --model $model_arg \
            --batch-size $bs \
            --iterations 1 \
            --warmup 1 \
            --input-len 128 \
            --output-len 1024 \
            --base-url http://127.0.0.1:$SERVE_PORT 2>@1]
    } err]} {
        puts "Benchmark failed for batch size $bs: $err"
        set duration "N/A"
        set output_throughput "N/A"
        set total_throughput "N/A"
        set mean_tpot "N/A"
        set mean_ttft "N/A"
    } else {
        puts $output
        # Extract metrics
        set duration [exec echo $output | grep "Benchmark duration" | awk {{print $NF}} 2>/dev/null]
        set output_throughput [exec echo $output | grep "Output token throughput" | awk {{print $NF}} 2>/dev/null]
        set total_throughput [exec echo $output | grep "Total Token throughput" | awk {{print $NF}} 2>/dev/null]
        set mean_tpot [exec echo $output | grep "Mean TPOT" | awk {{print $NF}} 2>/dev/null]
        set mean_ttft [exec echo $output | grep "Mean TTFT" | awk {{print $NF}} 2>/dev/null]

        # If empty, set to N/A
        if {$duration eq ""} { set duration "N/A" }
        if {$output_throughput eq ""} { set output_throughput "N/A" }
        if {$total_throughput eq ""} { set total_throughput "N/A" }
        if {$mean_tpot eq ""} { set mean_tpot "N/A" }
        if {$mean_ttft eq ""} { set mean_ttft "N/A" }
    }

    # Append formatted record
    append benchmark_formated_records [format $column_format $bs $duration $output_throughput $mean_ttft $mean_tpot $total_throughput]
    append benchmark_formated_records "\n"
    sleep 1
}
# Print table
puts "==================== BENCHMARK SUMMARY ===================="
puts $model_info
puts $benchmark_formated_records
puts "==========================================================="

proc send_to_lark {webhook_url message} {
    set escaped_message [string map {
        "\\" "\\\\" 
        "\"" "\\\"" 
        "\n" "\\n"
    } $message]
    
    set json_data "{\"msg_type\": \"text\", \"content\": {\"text\": \"$escaped_message\"}}"
    
    if {[catch {
        set result [exec curl -X POST $webhook_url \
            -H "Content-Type: application/json" \
            -d $json_data 2>@1]
        puts "Curl response: $result"
    } error_msg]} {
        puts "Failed to send to Lark: $error_msg"
    } else {
        puts "Successfully sent to Lark"
    }
}
if {$send_notification && $webhook_url_arg ne ""} {
    set lark_message "$model_info$benchmark_formated_records"
    puts "Sending benchmark results to Lark via $webhook_url_arg..."
    send_to_lark $webhook_url_arg $lark_message
} elseif {$send_notification} {
    puts "Webhook URL missing, skip notification."
} else {
    puts "Notification disabled (--no-notify)."
}


# Clean up
puts "Testing done. You may see some killing messages following, which is expected."
puts "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
exec kill $pid