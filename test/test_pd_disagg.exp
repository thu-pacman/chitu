#!/usr/bin/expect

# Show all output
log_user 1
exp_internal 0
set timeout -1

proc read_file {path} {
    if {$path eq "" || ![file exists $path] || ![file isfile $path]} {
        return ""
    }
    set size [file size $path]
    set fh [open $path r]
    set data [read $fh]
    close $fh
    return $data
}

proc read_tail {path max_bytes} {
    if {$path eq "" || ![file exists $path] || ![file isfile $path]} {
        return ""
    }
    set size [file size $path]
    set fh [open $path r]
    # max_bytes <= 0 means dump the entire file.
    if {$max_bytes > 0 && $size > $max_bytes} {
        seek $fh [expr {$size - $max_bytes}]
    }
    set data [read $fh]
    close $fh
    return $data
}

proc file_contains {path needle} {
    if {$path eq "" || ![file exists $path] || ![file isfile $path]} {
        return 0
    }
    set data [read_file $path]
    if {[string first $needle $data] >= 0} {
        return 1
    }
    return 0
}

proc env_or_default {name default} {
    global env
    if {[info exists env($name)] && $env($name) ne ""} {
        return $env($name)
    }
    return $default
}

proc file_has_error {path} {
    if {$path eq "" || ![file exists $path] || ![file isfile $path]} {
        return 0
    }
    set data [read_file $path]
    # Chitu log format: "LEVEL MM-DD HH:MM:SS ..." with optional ANSI color prefix
    if {[regexp -line {^(?:\x1b\[[0-9;]*m)*(?:ERROR|CRITICAL) \d{2}-\d{2} \d{2}:\d{2}:\d{2}} $data]} {
        return 1
    }
    if {[regexp {Traceback \(most recent call last\)} $data]} {
        return 1
    }
    # Slurm error messages: "srun: error: ..." / "slurmstepd: error: ..."
    if {[regexp -line {^(?:srun|slurmstepd): error:} $data]} {
        return 1
    }
    if {[regexp {Address already in use|EADDRINUSE} $data]} {
        return 1
    }
    return 0
}

proc glob_contains {pattern needle} {
    if {$pattern eq ""} {
        return 0
    }
    set files [glob -nocomplain $pattern]
    foreach f $files {
        if {[file isfile $f] && [file_contains $f $needle]} {
            return 1
        }
    }
    return 0
}

proc glob_has_error {pattern} {
    if {$pattern eq ""} {
        return 0
    }
    set files [glob -nocomplain $pattern]
    foreach f $files {
        if {[file isfile $f] && [file_has_error $f]} {
            return 1
        }
    }
    return 0
}

proc print_tail_if_exists {label path max_bytes} {
    if {$path ne "" && [file exists $path] && [file isfile $path]} {
        puts "--- $label: $path ---"
        puts [read_tail $path $max_bytes]
    }
}

proc dump_startup_logs {} {
    global srun_out router_log prefill_p0_glob prefill_p1_glob decode_d0_glob
    print_tail_if_exists "srun log" $srun_out -1
    foreach pattern [list $router_log $prefill_p0_glob $prefill_p1_glob $decode_d0_glob] {
        if {$pattern eq ""} {
            continue
        }
        foreach f [glob -nocomplain $pattern] {
            if {[file isfile $f]} {
                print_tail_if_exists "component log" $f -1
            }
        }
    }
}

proc ensure_process_alive {label} {
    global pd_pid
    if {[catch {exec kill -0 $pd_pid}]} {
        puts "ERROR: $label: PD process exited (pid=$pd_pid)"
        exit 1
    }
}

proc ensure_no_startup_error {label} {
    global srun_out router_log prefill_p0_glob prefill_p1_glob decode_d0_glob
    if {[file_has_error $srun_out]} {
        puts "ERROR: $label: srun output contains startup error"
        dump_startup_logs
        exit 1
    }
    foreach entry [list \
        [list "router" $router_log] \
        [list "prefill p0" $prefill_p0_glob] \
        [list "prefill p1" $prefill_p1_glob] \
        [list "decode d0" $decode_d0_glob]] {
        set comp_label [lindex $entry 0]
        set pattern [lindex $entry 1]
        if {[glob_has_error $pattern]} {
            puts "ERROR: $label: $comp_label log contains startup error"
            dump_startup_logs
            exit 1
        }
    }
}

proc port_is_open {host port} {
    if {[catch {exec nc -z $host $port}]} {
        return 0
    }
    return 1
}

proc wait_for_pattern {label pattern needle timeout_s} {
    set start [clock seconds]
    while {1} {
        update_slurm_job_id
        ensure_process_alive $label
        ensure_no_startup_error $label
        if {[glob_contains $pattern $needle]} {
            puts "OK: $label ready"
            return
        }
        if {[expr {[clock seconds] - $start}] > $timeout_s} {
            puts "ERROR: timeout waiting for $label"
            dump_startup_logs
            exit 1
        }
        sleep 2
    }
}

proc wait_for_router_ready {host port timeout_s} {
    set start [clock seconds]
    while {1} {
        update_slurm_job_id
        ensure_process_alive "Router readiness"
        ensure_no_startup_error "Router readiness"
        if {[port_is_open $host $port]} {
            puts "OK: Router ready on $host:$port"
            return
        }
        if {[expr {[clock seconds] - $start}] > $timeout_s} {
            puts "ERROR: timeout waiting for Router port $host:$port"
            dump_startup_logs
            exit 1
        }
        sleep 2
    }
}

proc extract_router {path} {
    if {![file exists $path]} {
        return ""
    }
    set data [read_file $path]
    if {[regexp {ROUTER: ([0-9\.]+):([0-9]+)} $data -> ip port]} {
        return [list $ip $port]
    }
    return ""
}

proc extract_job_id {path} {
    if {![file exists $path]} {
        return ""
    }
    set data [read_file $path]
    if {[regexp {srun: job ([0-9]+)} $data -> job_id]} {
        return $job_id
    }
    return ""
}

set pd_pid ""
set slurm_job_id ""
set cleanup_done 0

proc persist_slurm_job_id {} {
    global slurm_job_id slurm_job_id_file
    if {$slurm_job_id eq "" || $slurm_job_id_file eq ""} {
        return
    }
    set fh [open $slurm_job_id_file w]
    puts $fh $slurm_job_id
    close $fh
}

proc update_slurm_job_id {} {
    global srun_out slurm_job_id
    if {$slurm_job_id ne ""} {
        return
    }
    set job_id [extract_job_id $srun_out]
    if {$job_id ne ""} {
        set slurm_job_id $job_id
        persist_slurm_job_id
        puts "Detected Slurm job id: $slurm_job_id"
    }
}

proc cleanup_pd_processes {} {
    global cleanup_done pd_pid slurm_job_id
    if {$cleanup_done} {
        return
    }
    set cleanup_done 1
    update_slurm_job_id
    puts "Cleaning up PD resources..."
    if {$slurm_job_id ne ""} {
        catch {exec scancel $slurm_job_id}
    }
    if {$pd_pid ne ""} {
        catch {exec pkill -TERM -P $pd_pid}
        catch {exec kill -TERM $pd_pid}
        sleep 2
        catch {exec pkill -KILL -P $pd_pid}
        catch {exec kill -KILL $pd_pid}
    }
}

rename exit tcl_exit
proc exit {{code 0}} {
    cleanup_pd_processes
    tcl_exit $code
}
trap {cleanup_pd_processes; tcl_exit 1} {SIGINT SIGTERM SIGHUP}

puts "=== PD Disaggregation CI Test ==="
puts "Working directory: [pwd]"

set model_config [env_or_default "PD_MODEL_CONFIG" "Qwen3-30B-A3B-fp8"]
set model_ckpt_dir [env_or_default "PD_MODEL_CKPT_DIR" "/data/nfs/Qwen3-30B-A3B-FP8/"]
set model_spec [env_or_default "PD_MODEL_SPEC" ""]
set pd_spec [env_or_default "PD_PD_SPEC" "decode_wait_timeout_s=600,decode_prealloc_max_pending=128,decode_prealloc_token_budget=250000,decode_prealloc_reserved_tokens=1024,decode_max_running_tasks_per_dp=64"]
set default_prefill_spec "tp=1,pp=2,dp=2,ep=2,max_seq_len=8200,max_reqs=128,chunk=65536,full_warmup=True"
set prefill_spec [env_or_default "PD_PREFILL_SPEC" $default_prefill_spec]
set prefill_spec_p0 [env_or_default "PD_PREFILL_SPEC_0" $prefill_spec]
set prefill_spec_p1 [env_or_default "PD_PREFILL_SPEC_1" $prefill_spec]
set decode_spec [env_or_default "PD_DECODE_SPEC" "tp=2,pp=2,dp=2,ep=4,max_seq_len=10240,max_reqs=256,full_warmup=False"]
set srun_partition [env_or_default "PD_PARTITION" "ci"]
set bind_code [env_or_default "PD_BIND_CODE" "0"]
set router_port ""
set router_log ""
set prefill_p0_glob ""
set prefill_p1_glob ""
set decode_d0_glob ""

# Resolve Apptainer SIF
if {[info exists env(APPTAINER_IMAGE)] && $env(APPTAINER_IMAGE) ne ""} {
    set apptainer_image $env(APPTAINER_IMAGE)
} elseif {[info exists env(CHITU_COMMIT_IMAGE)] && $env(CHITU_COMMIT_IMAGE) ne ""} {
    set apptainer_image "/data/nfs/docker_images/$env(CHITU_COMMIT_IMAGE).sif"
} else {
    puts "ERROR: Please set APPTAINER_IMAGE or CHITU_COMMIT_IMAGE to a valid Mooncake SIF"
    exit 1
}
if {![file exists $apptainer_image]} {
    puts "ERROR: SIF not found: $apptainer_image"
    exit 1
}

if {[info exists env(LOG_DIR)] && $env(LOG_DIR) ne ""} {
    set log_dir $env(LOG_DIR)
} else {
    set log_dir "[pwd]/log"
    set env(LOG_DIR) $log_dir
}
file mkdir $log_dir
set srun_out "${log_dir}/srun.out"
set slurm_job_id_file "${log_dir}/slurm_job_id"
if {[file exists $slurm_job_id_file]} {
    file delete -force $slurm_job_id_file
}

set model_tag $model_config
regsub -all {[^A-Za-z0-9_.-]} $model_tag "_" model_tag

set cmd_parts [list bash script/srun_pd_disagg_base_apptainer.sh \
    $model_config $model_ckpt_dir $apptainer_image \
    --nodes 2 --gpus-per-node 8 --partition $srun_partition]
if {$model_spec ne ""} {
    lappend cmd_parts --model-spec $model_spec
}
if {$pd_spec ne ""} {
    lappend cmd_parts --pd-spec $pd_spec
}
lappend cmd_parts \
    --prefill $prefill_spec_p0 \
    --prefill $prefill_spec_p1 \
    --decode $decode_spec \
    --bind-code $bind_code
set cmd_str [join $cmd_parts " "]

puts "=== Launching PD Disaggregation via srun ==="
puts "SIF: $apptainer_image"
puts "Command: $cmd_str"
spawn -noecho bash -lc "set -e; $cmd_str > \"$srun_out\" 2>&1"
set pd_pid [exp_pid]
puts "PD environment launched, pid is $pd_pid"

puts "Waiting for srun to start (allocation or router logs)..."
while {1} {
    update_slurm_job_id
    ensure_process_alive "waiting for srun start"
    ensure_no_startup_error "waiting for srun start"
    set data [read_file $srun_out]
    if {[regexp {srun: job .* has been allocated resources} $data]} {
        puts "srun allocated resources."
        break
    }
    if {[extract_router $srun_out] ne ""} {
        puts "Detected router info before allocation line."
        break
    }
    if {[glob -nocomplain "${log_dir}/router.${model_tag}.log"] ne ""} {
        puts "Router log exists, continuing."
        break
    }
    if {[glob -nocomplain "${log_dir}/prefill.${model_tag}.p0.node*.log"] ne ""} {
        puts "Prefill log exists, continuing."
        break
    }
    if {[glob -nocomplain "${log_dir}/decode.${model_tag}.d0.node*.log"] ne ""} {
        puts "Decode log exists, continuing."
        break
    }
    sleep 2
}

set router_ip ""
set router_timeout 600
set start [clock seconds]
while {$router_ip eq ""} {
    update_slurm_job_id
    ensure_process_alive "waiting for router info"
    ensure_no_startup_error "waiting for router info"
    set info [extract_router $srun_out]
    if {$info ne ""} {
        set router_ip [lindex $info 0]
        set router_port [lindex $info 1]
        puts "Detected Router: $router_ip:$router_port"
        break
    }
    if {[expr {[clock seconds] - $start}] > $router_timeout} {
        puts "ERROR: timeout waiting for router info"
        puts [read_file $srun_out]
        exit 1
    }
    sleep 1
}

puts "Checking router port..."
if {[catch {exec nc -z $router_ip $router_port}]} {
    puts "Router port not open yet, continue waiting for logs..."
}

set router_log "${log_dir}/router.${model_tag}.log"
set prefill_p0_glob "${log_dir}/prefill.${model_tag}.p0.node*.log"
set prefill_p1_glob "${log_dir}/prefill.${model_tag}.p1.node*.log"
set decode_d0_glob "${log_dir}/decode.${model_tag}.d0.node*.log"
set worker_ready_str "Entering PD Worker Loop"

puts "Waiting for Router readiness..."
wait_for_router_ready $router_ip $router_port 1200
puts "Waiting for Prefill P0 readiness..."
wait_for_pattern "Prefill P0" $prefill_p0_glob $worker_ready_str 1200
puts "Waiting for Prefill P1 readiness..."
wait_for_pattern "Prefill P1" $prefill_p1_glob $worker_ready_str 1200
puts "Waiting for Decode D0 readiness..."
wait_for_pattern "Decode D0" $decode_d0_glob $worker_ready_str 1200

set bench_model [env_or_default "PD_BENCH_MODEL" $model_config]
set bench_batch_size [env_or_default "PD_BENCH_BATCH_SIZE" "128"]
set bench_iterations [env_or_default "PD_BENCH_ITERATIONS" "1"]
set bench_input_len [env_or_default "PD_BENCH_INPUT_LEN" "8192"]
set bench_output_len [env_or_default "PD_BENCH_OUTPUT_LEN" "2048"]
set bench_warmup [env_or_default "PD_BENCH_WARMUP" "1"]
set bench_dataset [env_or_default "PD_BENCH_DATASET" "sharegpt"]
set bench_dataset_path [env_or_default "PD_BENCH_DATASET_PATH" "/data/nfs/ShareGPT_V3_unfiltered_cleaned_split.json"]
set bench_tokenizer_path [env_or_default "PD_BENCH_TOKENIZER_PATH" "/data/nfs/Qwen3-30B-A3B-FP8/"]
set bench_output_dir [env_or_default "PD_BENCH_OUTPUT_DIR" "benchmark_output_${model_tag}_temp"]
if {[file pathtype $bench_output_dir] ne "absolute"} {
    set bench_output_dir "[pwd]/$bench_output_dir"
}
file mkdir $bench_output_dir

set bench_inner_cmd "PY=python; if test -x /opt/conda/bin/python; then PY=/opt/conda/bin/python; fi; \
    export PYTHONNOUSERSITE=1; \
    export PYTHONPATH=; \
    echo \"PYTHON_BIN=\$PY\"; \
    which \$PY || true; \
    \$PY -c \"import sys; print('python:', sys.executable); import transformers; print('transformers:', transformers.__version__)\"; \
    cd /workspace/chitu/benchmarks && \$PY benchmark_serving.py \
    --batch-size $bench_batch_size \
    --model $bench_model \
    --iterations $bench_iterations \
    --input-len $bench_input_len \
    --output-len $bench_output_len \
    --warmup $bench_warmup \
    --dataset $bench_dataset \
    --dataset-path $bench_dataset_path \
    --tokenizer-path $bench_tokenizer_path \
    --output-dir $bench_output_dir/ \
    --base-url http://$router_ip:$router_port"

set bench_cmd [list apptainer exec --nv -B /data:/data -B /home:/home \
    $apptainer_image \
    bash -lc $bench_inner_cmd]

puts "=== Running benchmark ==="
puts "Command: $bench_cmd"
spawn -noecho {*}$bench_cmd
set bench_spawn_id $spawn_id
expect -i $bench_spawn_id -timeout 7200 {
    -re {.+} {
        puts -nonewline -- $expect_out(0,string)
        exp_continue
    }
    eof {
        puts "\n--- Benchmark finished ---"
    }
    timeout {
        puts "ERROR: benchmark timeout"
        dump_startup_logs
        exit 1
    }
}
set bench_status [wait -i $bench_spawn_id]
set bench_exit [lindex $bench_status 3]
if {$bench_exit ne "0"} {
    puts "ERROR: benchmark failed with exit code $bench_exit"
    dump_startup_logs
    exit 1
}

set json_path "$bench_output_dir/benchmark_results.jsonl"
if {![file exists $json_path]} {
    puts "ERROR: benchmark results not found: $json_path"
    dump_startup_logs
    exit 1
}

set py_code {
import json
import sys

path = sys.argv[1]
print("=== Benchmark generated_texts and errors ===")
has_error = False
def handle_obj(obj, prefix=""):
    global has_error
    texts = obj.get("generated_texts", [])
    errors = obj.get("errors", [])
    for i, t in enumerate(texts):
        preview = t[:1024] + "..." if len(t) > 1024 else t
        print(f"{prefix}generated_texts[{i}]: {preview}")
    for i, e in enumerate(errors):
        if e:
            has_error = True
            print(f"{prefix}ERROR errors[{i}]: {e}")

with open(path, "r", encoding="utf-8") as f:
    content = f.read().strip()

if not content:
    print("ERROR: empty benchmark results")
    sys.exit(1)

parsed_any = False
try:
    obj = json.loads(content)
    parsed_any = True
    if isinstance(obj, list):
        for idx, item in enumerate(obj, 1):
            if isinstance(item, dict):
                handle_obj(item, prefix=f"[item {idx}] ")
    elif isinstance(obj, dict):
        handle_obj(obj)
    else:
        print(f"WARN: unexpected json root type: {type(obj)}")
except json.JSONDecodeError as e:
    print(f"WARN: failed to parse full json: {e}")
    print(f"WARN: content head: {content[:200]!r}")
    print(f"WARN: content tail: {content[-200:]!r}")
    parsed_any = False

if not parsed_any:
    for line_no, line in enumerate(content.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            print(f"[line {line_no}] WARN: skip non-json line: {line[:120]}")
            continue
        parsed_any = True
        if isinstance(obj, dict):
            handle_obj(obj, prefix=f"[line {line_no}] ")

if not parsed_any:
    print("ERROR: no valid json records found")
    sys.exit(1)
if has_error:
    print("ERROR: non-empty errors found")
    sys.exit(1)
}

puts "=== Printing benchmark generated_texts and errors ==="
set parse_cmd [list python3 -c $py_code $json_path]
spawn -noecho {*}$parse_cmd
set parse_spawn_id $spawn_id
expect -i $parse_spawn_id -timeout 7200 {
    -re {.+} {
        puts -nonewline -- $expect_out(0,string)
        exp_continue
    }
    eof {
        puts "\n--- Parse finished ---"
    }
    timeout {
        puts "ERROR: parse timeout"
        dump_startup_logs
        exit 1
    }
}
set parse_status [wait -i $parse_spawn_id]
set parse_exit [lindex $parse_status 3]
if {$parse_exit ne "0"} {
    puts "ERROR: benchmark validation failed"
    dump_startup_logs
    exit 1
}

puts "=== PD Disaggregation CI Test Completed ==="
exit 0
