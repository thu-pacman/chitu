#!/usr/bin/expect

# Show all output
log_user 1
exp_internal 0
set timeout -1

proc read_tail {path max_bytes} {
    if {![file exists $path]} {
        return ""
    }
    set size [file size $path]
    set fh [open $path r]
    if {$size > $max_bytes} {
        seek $fh [expr {$size - $max_bytes}]
    }
    set data [read $fh]
    close $fh
    return $data
}

proc file_contains {path needle} {
    if {![file exists $path]} {
        return 0
    }
    set data [read_tail $path 20000]
    if {[string first $needle $data] >= 0} {
        return 1
    }
    return 0
}

proc file_has_error {path} {
    if {![file exists $path]} {
        return 0
    }
    set data [read_tail $path 20000]
    if {[regexp {ERROR|Exception|Traceback} $data]} {
        return 1
    }
    return 0
}

proc glob_contains {pattern needle} {
    set files [glob -nocomplain $pattern]
    foreach f $files {
        if {[file_contains $f $needle]} {
            return 1
        }
    }
    return 0
}

proc glob_has_error {pattern} {
    set files [glob -nocomplain $pattern]
    foreach f $files {
        if {[file_has_error $f]} {
            return 1
        }
    }
    return 0
}

proc ensure_process_alive {label} {
    global svc_pid
    if {[catch {exec kill -0 $svc_pid}]} {
        puts "ERROR: $label: service process exited (pid=$svc_pid)"
        exit 1
    }
}

proc wait_for_pattern {label pattern needle timeout_s} {
    set start [clock seconds]
    while {1} {
        ensure_process_alive $label
        if {[glob_contains $pattern $needle]} {
            puts "OK: $label ready"
            return
        }
        if {[glob_has_error $pattern]} {
            puts "ERROR: $label log contains error"
            exit 1
        }
        if {[expr {[clock seconds] - $start}] > $timeout_s} {
            puts "ERROR: timeout waiting for $label"
            exit 1
        }
        sleep 2
    }
}

proc extract_router {path} {
    if {![file exists $path]} {
        return ""
    }
    set data [read_tail $path 20000]
    if {[regexp {ROUTER: ([0-9\.]+):([0-9]+)} $data -> ip port]} {
        return [list $ip $port]
    }
    return ""
}

proc env_get {name} {
    if {[info exists ::env($name)] && $::env($name) ne ""} {
        return $::env($name)
    }
    return ""
}

proc env_get_or {name default_val} {
    set val [env_get $name]
    if {$val ne ""} { return $val }
    return $default_val
}

proc send_feishu {webhook text} {
    set py_code {
import json
import sys
import urllib.request

url = sys.argv[1]
text = sys.argv[2]
payload = {"msg_type": "text", "content": {"text": text}}
data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
with urllib.request.urlopen(req, timeout=10) as resp:
    sys.stdout.write(resp.read().decode("utf-8"))
}
    set cmd [list python3 -c $py_code $webhook $text]
    if {[catch {set out [exec {*}$cmd]} err]} {
        puts "WARN: Feishu notify failed: $err"
        return 0
    }
    puts "Feishu notify response: $out"
    return 1
}

set deploy_mode [env_get_or "PD_DEPLOY_MODE" "pd_disagg"]
puts "=== Daily Benchmark (mode=$deploy_mode) ==="
puts "Working directory: [pwd]"

set model_config [env_get_or "PD_MODEL_CONFIG" "Qwen3-235B-A22B-fp8"]
set model_ckpt_dir [env_get_or "PD_MODEL_CKPT_DIR" "/data/nfs/Qwen3-235B-A22B-FP8/"]
set tokenizer_path [env_get_or "PD_TOKENIZER_PATH" $model_ckpt_dir]
set router_port [env_get_or "PD_ROUTER_PORT" "21004"]
set nodes [env_get_or "PD_NODES" "4"]
set gpus_per_node [env_get_or "PD_GPUS_PER_NODE" "8"]
set bind_code [env_get_or "PD_BIND_CODE" "1"]
set model_spec [env_get "PD_MODEL_SPEC"]

set bench_batch_size [env_get_or "PD_BENCH_BATCH_SIZE" "128"]
set bench_input_len [env_get_or "PD_BENCH_INPUT_LEN" "1024"]
set bench_output_len [env_get_or "PD_BENCH_OUTPUT_LEN" "1024"]
set bench_warmup [env_get_or "PD_BENCH_WARMUP" "1"]
set bench_iterations [env_get_or "PD_BENCH_ITERATIONS" "1"]
set dataset_path [env_get_or "PD_DATASET_PATH" "/data/nfs/ShareGPT_V3_unfiltered_cleaned_split.json"]
set common_overrides_str [env_get "PD_COMMON_OVERRIDES"]

if {$deploy_mode eq "multi_instance"} {
    set mi_num_instances [env_get_or "MI_NUM_INSTANCES" "4"]
    set mi_instance_default [env_get_or "MI_INSTANCE_DEFAULT" "tp=2,max_seq_len=6144,max_reqs=128,full_warmup=True"]
    set mi_instance_specs_str [env_get "MI_INSTANCE_SPECS"]
    set mi_lb_algorithm [env_get_or "MI_LB_ALGORITHM" "round_robin"]
    if {$common_overrides_str eq ""} { set common_overrides_str "metrics.log_interval=10" }
} else {
    set prefill_specs_str [env_get_or "PD_PREFILL_SPECS" "tp=4,pp=2,dp=1,ep=1,max_seq_len=5200,max_reqs=384,chunk=61440,full_warmup=True|tp=4,pp=2,dp=1,ep=1,max_seq_len=5200,max_reqs=384,chunk=61440,full_warmup=True"]
    set decode_specs_str [env_get_or "PD_DECODE_SPECS" "tp=1,pp=1,dp=16,ep=16,max_seq_len=6200,max_reqs=896,full_warmup=True,infer.memory_utilization=0.99"]
    if {$common_overrides_str eq ""} { set common_overrides_str "dp_config.router.pd_disaggregation.kv_transfer.decode_wait_timeout_s=1200|dp_config.router.pd_disaggregation.kv_transfer.decode_prealloc_max_pending=256|dp_config.router.pd_disaggregation.kv_transfer.decode_prealloc_token_budget=350000|dp_config.router.pd_disaggregation.kv_transfer.decode_prealloc_reserved_tokens=512|dp_config.router.pd_disaggregation.kv_transfer.decode_max_running_tasks_per_dp=50|metrics.log_interval=10" }
    set prefill_specs [split $prefill_specs_str "|"]
    set decode_specs [split $decode_specs_str "|"]
    set prefill_count [llength $prefill_specs]
    set decode_count [llength $decode_specs]
}

set common_override_list [split $common_overrides_str "|"]

set partition [env_get_or "PD_PARTITION" "ci-long"]
if {[info exists env(SLURM_PARTITION)] && $env(SLURM_PARTITION) ne ""} {
    set partition $env(SLURM_PARTITION)
}

puts "Model config:   $model_config"
puts "Checkpoint dir: $model_ckpt_dir"
puts "Tokenizer:      $tokenizer_path"
puts "Topology:       $nodes nodes x $gpus_per_node GPUs"
if {$deploy_mode eq "multi_instance"} {
    puts "Instances:      $mi_num_instances (default: $mi_instance_default)"
} else {
    puts "Prefill(s):     $prefill_count instance(s)"
    puts "Decode(s):      $decode_count instance(s)"
}

# Resolve Apptainer SIF
if {[info exists env(APPTAINER_IMAGE)] && $env(APPTAINER_IMAGE) ne ""} {
    set apptainer_image $env(APPTAINER_IMAGE)
} elseif {[info exists env(CHITU_COMMIT_IMAGE)] && $env(CHITU_COMMIT_IMAGE) ne ""} {
    set apptainer_image "/data/nfs/docker_images/$env(CHITU_COMMIT_IMAGE).sif"
} else {
    puts "ERROR: Please set APPTAINER_IMAGE or CHITU_COMMIT_IMAGE to a valid Mooncake SIF"
    exit 1
}
if {![file exists $apptainer_image]} {
    puts "ERROR: SIF not found: $apptainer_image"
    exit 1
}

set log_dir "[pwd]/log"
set env(LOG_DIR) $log_dir
file mkdir $log_dir
set srun_out "${log_dir}/srun.out"

set model_tag $model_config
regsub -all {[^A-Za-z0-9_.-]} $model_tag "_" model_tag

if {$deploy_mode eq "multi_instance"} {
    set cmd_parts [list bash script/srun_multi_instance_apptainer.sh \
        $model_config $model_ckpt_dir $apptainer_image \
        --nodes $nodes --gpus-per-node $gpus_per_node --router-port $router_port --partition $partition \
        --bind-code $bind_code --load-balancer-algorithm $mi_lb_algorithm \
        --instance-default $mi_instance_default]
    if {$mi_instance_specs_str ne ""} {
        foreach spec [split $mi_instance_specs_str "|"] {
            if {$spec ne ""} { lappend cmd_parts --instance $spec }
        }
    } else {
        lappend cmd_parts --instances $mi_num_instances
    }
} else {
    set cmd_parts [list bash script/srun_pd_disagg_base_apptainer.sh \
        $model_config $model_ckpt_dir $apptainer_image \
        --nodes $nodes --gpus-per-node $gpus_per_node --router-port $router_port --partition $partition \
        --bind-code $bind_code]
    foreach spec $prefill_specs {
        if {$spec ne ""} { lappend cmd_parts --prefill $spec }
    }
    foreach spec $decode_specs {
        if {$spec ne ""} { lappend cmd_parts --decode $spec }
    }
}

if {$model_spec ne ""} {
    lappend cmd_parts --model-spec $model_spec
}
foreach ovr $common_override_list {
    if {$ovr ne ""} {
        lappend cmd_parts --common-override $ovr
    }
}
set cmd_str [join $cmd_parts " "]

puts "=== Launching ($deploy_mode) via srun ==="
puts "SIF: $apptainer_image"
puts "Command: $cmd_str"
spawn bash -lc "set -e; $cmd_str > \"$srun_out\" 2>&1"
set svc_pid [exp_pid]
puts "Service launched ($deploy_mode), pid=$svc_pid"

puts "Waiting for srun to start (allocation or router logs)..."
while {1} {
    ensure_process_alive "waiting for srun start"
    set data [read_tail $srun_out 20000]
    if {[regexp {srun: job .* has been allocated resources} $data]} {
        puts "srun allocated resources."
        break
    }
    if {[extract_router $srun_out] ne ""} {
        puts "Detected router info before allocation line."
        break
    }
    if {[glob -nocomplain "${log_dir}/router.${model_tag}.log"] ne ""} {
        puts "Router log exists, continuing."
        break
    }
    if {[glob -nocomplain "${log_dir}/prefill.${model_tag}.p0.node*.log"] ne "" ||
        [glob -nocomplain "${log_dir}/instance.${model_tag}.i0.node*.log"] ne ""} {
        puts "Worker log exists, continuing."
        break
    }
    if {[glob -nocomplain "${log_dir}/decode.${model_tag}.d0.node*.log"] ne ""} {
        puts "Decode log exists, continuing."
        break
    }
    sleep 2
}

set router_ip ""
set router_timeout 1200
set start [clock seconds]
while {$router_ip eq ""} {
    ensure_process_alive "waiting for router info"
    if {[file_has_error $srun_out]} {
        puts "ERROR: srun output contains error"
        puts [read_tail $srun_out 4000]
        exit 1
    }
    set info [extract_router $srun_out]
    if {$info ne ""} {
        set router_ip [lindex $info 0]
        set router_port [lindex $info 1]
        puts "Detected Router: $router_ip:$router_port"
        break
    }
    if {[expr {[clock seconds] - $start}] > $router_timeout} {
        puts "ERROR: timeout waiting for router info"
        puts [read_tail $srun_out 4000]
        exit 1
    }
    sleep 1
}

puts "Checking router port..."
if {[catch {exec nc -z $router_ip $router_port}]} {
    puts "Router port not open yet, continue waiting for logs..."
}

set router_log "${log_dir}/router.${model_tag}.log"
set router_ready_str "Uvicorn running on http://0.0.0.0:${router_port}"

puts "Waiting for Router readiness..."
wait_for_pattern "Router" $router_log $router_ready_str 1800

if {$deploy_mode eq "multi_instance"} {
    set worker_ready_str "Starting to process requests"
    if {$mi_instance_specs_str ne ""} {
        set _inst_count [llength [split $mi_instance_specs_str "|"]]
    } else {
        set _inst_count $mi_num_instances
    }
    for {set i 0} {$i < $_inst_count} {incr i} {
        set label "Instance I${i}"
        set pattern "${log_dir}/instance.${model_tag}.i${i}.node*.log"
        puts "Waiting for ${label} readiness..."
        wait_for_pattern $label $pattern $worker_ready_str 3600
    }
} else {
    set worker_ready_str "Entering PD Worker Loop"
    for {set i 0} {$i < $prefill_count} {incr i} {
        set label "Prefill P${i}"
        set pattern "${log_dir}/prefill.${model_tag}.p${i}.node*.log"
        puts "Waiting for ${label} readiness..."
        wait_for_pattern $label $pattern $worker_ready_str 1800
    }
    for {set i 0} {$i < $decode_count} {incr i} {
        set label "Decode D${i}"
        set pattern "${log_dir}/decode.${model_tag}.d${i}.node*.log"
        puts "Waiting for ${label} readiness..."
        wait_for_pattern $label $pattern $worker_ready_str 1800
    }
}

set pd_output_dir [env_get "PD_OUTPUT_DIR"]
if {$pd_output_dir ne ""} {
    set bench_output_dir $pd_output_dir
} else {
    set bench_output_dir "[pwd]/benchmark_output_${deploy_mode}_${model_tag}"
}
if {[file exists $bench_output_dir]} {
    file delete -force $bench_output_dir
}
file mkdir $bench_output_dir

################################################################################
# Phase 3: Multi-batch benchmark loop
################################################################################

set batch_sizes_str [env_get "PD_BENCH_BATCH_SIZES"]
if {$batch_sizes_str ne ""} {
    set batch_sizes [split $batch_sizes_str ","]
} else {
    set batch_sizes [list]
    set _bs $bench_batch_size
    while {$_bs <= 512} {
        lappend batch_sizes $_bs
        set _bs [expr {$_bs * 2}]
    }
}

proc extract_spec_field {spec field} {
    foreach kv [split $spec ","] {
        set parts [split $kv "="]
        if {[lindex $parts 0] eq $field} {
            return [lindex $parts 1]
        }
    }
    return ""
}

if {$deploy_mode eq "multi_instance"} {
    set mi_spec_for_fields $mi_instance_default
    set i_tp [extract_spec_field $mi_spec_for_fields "tp"]
    set i_pp [extract_spec_field $mi_spec_for_fields "pp"]
    set i_dp [extract_spec_field $mi_spec_for_fields "dp"]
    set i_ep [extract_spec_field $mi_spec_for_fields "ep"]
    if {$i_tp eq ""} { set i_tp 1 }
    if {$i_pp eq ""} { set i_pp 1 }
    if {$i_dp eq ""} { set i_dp 1 }
    if {$i_ep eq ""} { set i_ep 1 }
    set d_tp $i_tp; set d_pp $i_pp; set d_dp $i_dp; set d_ep $i_ep

    set model_info "Model: $model_config\n"
    append model_info "Mode: Multi-Instance (unified)\n"
    append model_info "Instances: ${_inst_count}x (TP${i_tp}-PP${i_pp})\n"
    append model_info "LB: $mi_lb_algorithm\n"
} else {
    set first_decode [lindex $decode_specs 0]
    set d_tp [extract_spec_field $first_decode "tp"]
    set d_pp [extract_spec_field $first_decode "pp"]
    set d_dp [extract_spec_field $first_decode "dp"]
    set d_ep [extract_spec_field $first_decode "ep"]
    if {$d_tp eq ""} { set d_tp 1 }
    if {$d_pp eq ""} { set d_pp 1 }
    if {$d_dp eq ""} { set d_dp 1 }
    if {$d_ep eq ""} { set d_ep 1 }

    set first_prefill [lindex $prefill_specs 0]
    set p_tp [extract_spec_field $first_prefill "tp"]
    set p_pp [extract_spec_field $first_prefill "pp"]
    if {$p_tp eq ""} { set p_tp 1 }
    if {$p_pp eq ""} { set p_pp 1 }

    set model_info "Model: $model_config\n"
    append model_info "Mode: PD Disaggregation\n"
    append model_info "Prefill: ${prefill_count}x (TP${p_tp}-PP${p_pp})\n"
    append model_info "Decode: ${decode_count}x (TP${d_tp}-PP${d_pp}-DP${d_dp}-EP${d_ep})\n"
}

set column_format "%-12s %-24s %-14s %-11s %-11s %s"
set benchmark_records [format $column_format "Batch Size" "Benchmark duration (s)" "TPS (tok/s)" "TTFT (ms)" "TPOT (ms)" "Total Throughput (tok/s)"]
append benchmark_records "\n"
append benchmark_records [format $column_format "------------" "------------------------" "--------------" "-----------" "-----------" "-------------------------"]
append benchmark_records "\n"

foreach bs $batch_sizes {
    puts "Starting test with batch size = $bs..."

    set bench_inner_cmd "PY=python; if test -x /opt/conda/bin/python; then PY=/opt/conda/bin/python; fi; \
        export PYTHONNOUSERSITE=1; \
        export PYTHONPATH=; \
        cd /workspace/chitu/benchmarks && \$PY benchmark_serving.py \
        --batch-size $bs \
        --model $model_config \
        --iterations $bench_iterations \
        --input-len $bench_input_len \
        --output-len $bench_output_len \
        --warmup $bench_warmup \
        --dataset sharegpt \
        --dataset-path $dataset_path \
        --tokenizer-path $tokenizer_path \
        --output-dir $bench_output_dir/ \
        --append-result \
        --base-url http://$router_ip:$router_port"

    set duration "N/A"
    set output_throughput "N/A"
    set total_throughput "N/A"
    set mean_tpot "N/A"
    set mean_ttft "N/A"

    if {[catch {
        set output [exec apptainer exec --nv -B /data:/data -B /home:/home \
            $apptainer_image \
            bash -lc $bench_inner_cmd 2>@1]
    } err]} {
        puts "Benchmark failed for batch size $bs: $err"
    } else {
        puts $output

        catch { set duration [exec echo $output | grep "Benchmark duration" | awk {{print $NF}} 2>/dev/null] }
        catch { set output_throughput [exec echo $output | grep "Output token throughput" | awk {{print $NF}} 2>/dev/null] }
        catch { set total_throughput [exec echo $output | grep "Total Token throughput" | awk {{print $NF}} 2>/dev/null] }
        catch { set mean_tpot [exec echo $output | grep "Mean TPOT" | awk {{print $NF}} 2>/dev/null] }
        catch { set mean_ttft [exec echo $output | grep "Mean TTFT" | awk {{print $NF}} 2>/dev/null] }

        if {$duration eq ""} { set duration "N/A" }
        if {$output_throughput eq ""} { set output_throughput "N/A" }
        if {$total_throughput eq ""} { set total_throughput "N/A" }
        if {$mean_tpot eq ""} { set mean_tpot "N/A" }
        if {$mean_ttft eq ""} { set mean_ttft "N/A" }
    }

    append benchmark_records [format $column_format $bs $duration $output_throughput $mean_ttft $mean_tpot $total_throughput]
    append benchmark_records "\n"

    set pic_dir "${bench_output_dir}/pics"
    exec mkdir -p $pic_dir
    puts "Generating visualization: $pic_dir"
    if {[catch {
        set viz_output [exec apptainer exec --nv \
            -B /data:/data -B /home:/home -B /tmp:/tmp \
            $apptainer_image \
            bash -lc "cd /workspace/chitu && python benchmarks/visualize_response.py \
                --benchmark-results $bench_output_dir/benchmark_results.jsonl \
                --save-path $pic_dir" 2>@1]
    } viz_err]} {
        puts "Visualization failed for batch size $bs: $viz_err"
    } else {
        puts $viz_output
        puts "Visualization saved: $pic_dir"
    }

    sleep 1
}

################################################################################
# Phase 4: Record to Feishu bitable (via record_daily_bench)
################################################################################

set json_path "$bench_output_dir/benchmark_results.jsonl"
if {![file exists $json_path]} {
    puts "ERROR: benchmark results not found: $json_path"
    exit 1
}

set recipes_dir "/data/nfs/recipes"
set record_log "$bench_output_dir/record_daily_bench.log"

set send_notification 1
set no_notify [env_get "PD_NO_NOTIFY"]
if {$no_notify eq "1"} {
    set send_notification 0
}

if {$deploy_mode eq "multi_instance"} {
    set cmd_args_summary "Multi-Instance: ${_inst_count}x(TP${i_tp}-PP${i_pp}), LB=${mi_lb_algorithm}, nodes=${nodes}, gpus_per_node=${gpus_per_node}"
    set parallel_scheme "MI:${_inst_count}x(TP${i_tp}-PP${i_pp})"
    set deploy_mode_label "MULTI_INSTANCE"
} else {
    set cmd_args_summary "PD Disagg: prefill=${prefill_count}x(TP${p_tp}-PP${p_pp}), decode=${decode_count}x(TP${d_tp}-PP${d_pp}-DP${d_dp}-EP${d_ep}), nodes=${nodes}, gpus_per_node=${gpus_per_node}"
    set parallel_scheme "P:${prefill_count}x(TP${p_tp}-PP${p_pp})+D:${decode_count}x(TP${d_tp}-PP${d_pp}-DP${d_dp}-EP${d_ep})"
    set deploy_mode_label "PD_DISAGG"
}

if {$send_notification && [file isdirectory $recipes_dir]} {
    puts "=== Writing records to Feishu bitable ==="
    if {[catch {
        set record_output [exec apptainer exec --nv \
            -B /data:/data -B /home:/home -B /tmp:/tmp \
            --env BENCHMARK_OUTPUT_DIR=$bench_output_dir \
            --env MODEL_NAME=$model_config \
            --env TP_SIZE=$d_tp \
            --env PP_SIZE=$d_pp \
            --env DP_SIZE=$d_dp \
            --env EP_SIZE=$d_ep \
            --env INPUT_LEN=$bench_input_len \
            --env OUTPUT_LEN=$bench_output_len \
            --env CMD_ARGS=$cmd_args_summary \
            --env PARALLEL_SCHEME=$parallel_scheme \
            --env DEPLOY_MODE=$deploy_mode_label \
            $apptainer_image \
            bash -lc "cd $recipes_dir && python -m recipes.tools.record_daily_bench" 2>@1]
    } record_err]} {
        puts "WARN: record_daily_bench failed: $record_err"
    } else {
        puts $record_output
    }
} else {
    if {!$send_notification} {
        puts "Notification disabled (PD_NO_NOTIFY=1)."
    } else {
        puts "WARN: recipes dir not found ($recipes_dir), skip bitable upload."
    }
}

################################################################################
# Phase 5: Validation (check generated_texts / errors)
################################################################################

set py_code {
import json
import sys

path = sys.argv[1]
print("=== Benchmark results validation ===")
has_error = False
total_texts = 0
total_errors = 0
def handle_obj(obj, prefix=""):
    global has_error, total_texts, total_errors
    texts = obj.get("generated_texts", [])
    errors = obj.get("errors", [])
    total_texts += len(texts)
    for i, t in enumerate(texts):
        preview = t[:200] + "..." if len(t) > 200 else t
        print(f"{prefix}generated_texts[{i}]: {preview}")
    for i, e in enumerate(errors):
        if e:
            total_errors += 1
            has_error = True
            print(f"{prefix}ERROR errors[{i}]: {e}")

with open(path, "r", encoding="utf-8") as f:
    content = f.read().strip()

if not content:
    print("ERROR: empty benchmark results")
    sys.exit(1)

parsed_any = False
for line_no, line in enumerate(content.splitlines(), 1):
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except json.JSONDecodeError:
        print(f"[line {line_no}] WARN: skip non-json line: {line[:120]}")
        continue
    parsed_any = True
    if isinstance(obj, dict):
        handle_obj(obj, prefix=f"[batch {line_no}] ")

if not parsed_any:
    print("ERROR: no valid json records found")
    sys.exit(1)
print(f"Total generated_texts: {total_texts}, errors: {total_errors}")
if has_error:
    print("ERROR: non-empty errors found")
    sys.exit(1)
print("Validation PASSED")
}

puts "=== Validating benchmark results ==="
set parse_cmd [list python3 -c $py_code $json_path]
spawn {*}$parse_cmd
set parse_spawn_id $spawn_id
expect -i $parse_spawn_id -timeout 7200 {
    -re {.+} {
        puts -nonewline -- $expect_out(0,string)
        exp_continue
    }
    eof {
        puts "\n--- Validation finished ---"
    }
    timeout {
        puts "ERROR: validation timeout"
        exit 1
    }
}
set parse_status [wait -i $parse_spawn_id]
set parse_exit [lindex $parse_status 3]
if {$parse_exit ne "0"} {
    puts "ERROR: benchmark validation failed"
    exit 1
}

################################################################################
# Phase 6: BENCHMARK SUMMARY
################################################################################

puts "==================== BENCHMARK SUMMARY ===================="
puts $model_info
puts $benchmark_records
puts "==========================================================="

################################################################################
# Phase 7: Feishu webhook notification (optional, in addition to bitable)
################################################################################

set feishu_webhook [env_get "FEISHU_WEBHOOK_URL"]
if {$feishu_webhook eq ""} {
    set feishu_webhook [env_get "LARK_WEBHOOK_URL"]
}
if {$feishu_webhook eq ""} {
    set feishu_webhook [env_get "FEISHU_WEBHOOK"]
}

if {$deploy_mode eq "multi_instance"} {
    set notify_text "Multi-Instance Daily Benchmark: PASS\nmodel=$model_config\nnodes=$nodes gpus_per_node=$gpus_per_node instances=$_inst_count LB=$mi_lb_algorithm\nrouter=$router_ip:$router_port\nbatch_sizes=[join $batch_sizes ,]\nresults=$json_path"
} else {
    set notify_text "PD Disagg Daily Benchmark: PASS\nmodel=$model_config\nnodes=$nodes gpus_per_node=$gpus_per_node prefill=$prefill_count decode=$decode_count\nrouter=$router_ip:$router_port\nbatch_sizes=[join $batch_sizes ,]\nresults=$json_path"
}
set job_url [env_get "CI_JOB_URL"]
if {$job_url ne ""} {
    append notify_text "\njob=$job_url"
}
set pipeline_url [env_get "CI_PIPELINE_URL"]
if {$pipeline_url ne ""} {
    append notify_text "\npipeline=$pipeline_url"
}
if {$feishu_webhook ne ""} {
    puts "Sending Feishu webhook notification..."
    send_feishu $feishu_webhook $notify_text
} else {
    puts "Feishu webhook not set, skip webhook notify."
}

puts "Testing done. You may see some killing messages following, which is expected."
puts "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"

puts "Cleaning up processes..."
catch {exec kill -TERM $svc_pid}
sleep 5
puts "=== Daily Benchmark Completed (mode=$deploy_mode) ==="
exit 0
